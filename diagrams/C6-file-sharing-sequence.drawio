(receiver)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="30" width="140" height="50" as="geometry"/></mxCell><mxCell id="8" style="endArrow=none;dashed=1;strokeColor=#999999;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="80" as="sourcePoint"/><mxPoint x="720" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="9" value="1. Choose the 2 GB video and the phone" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="130" as="sourcePoint"/><mxPoint x="420" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="10" value="2. Offer: name, size, fingerprint (control channel)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="176" as="sourcePoint"/><mxPoint x="720" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="11" value="3. Ask: accept this file from the laptop?" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="222" as="sourcePoint"/><mxPoint x="120" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="4. Accept" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="268" as="sourcePoint"/><mxPoint x="720" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="5. Accepted + transfer ID" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="314" as="sourcePoint"/><mxPoint x="420" y="314" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="6. File channel: chunks 1, 2, 3 ..." style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="360" as="sourcePoint"/><mxPoint x="720" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="7. Saves chunks to a temp file; shows progress" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1"><mxGeometry x="456" y="392" width="260" height="28" as="geometry"/></mxCell><mxCell id="16" value="8. Connection drops at chunk 412 (Wi-Fi lost / phone sleeps)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="452" as="sourcePoint"/><mxPoint x="720" y="452" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="9. Laptop: status Paused, keeps the transfer ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1"><mxGeometry x="424" y="484" width="260" height="28" as="geometry"/></mxCell><mxCell id="18" value="10. Phone: keeps chunks 1-412, status Paused" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1"><mxGeometry x="456" y="530" width="260" height="28" as="geometry"/></mxCell><mxCell id="19" value="11. Devices see each other again: Resume(transfer ID)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="590" as="sourcePoint"/><mxPoint x="720" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="12. I already have chunks 1-412" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="636" as="sourcePoint"/><mxPoint x="420" y="636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="13. File channel: chunks 413 ... last" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="682" as="sourcePoint"/><mxPoint x="720" y="682" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="14. Checks the fingerprint, saves the file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1"><mxGeometry x="456" y="714" width="260" height="28" as="geometry"/></mxCell><mxCell id="23" value="15. Notification: video received" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="774" as="sourcePoint"/><mxPoint x="120" y="774" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="16. Done" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=9;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="820" as="sourcePoint"/><mxPoint x="420" y="820" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>