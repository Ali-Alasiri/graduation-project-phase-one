 x="415.0" y="210"/></Array></mxGeometry></mxCell><mxCell id="c15" value="3. add login (site, user name, password)" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125.0" y="254" as="sourcePoint"/><mxPoint x="375.0" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="4. save in vault (SQLCipher), version + 1" style="html=1;endArrow=block;endFill=1;align=left;spacingLeft=6;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375.0" y="298" as="sourcePoint"/><mxPoint x="375.0" y="314" as="targetPoint"/><Array as="points"><mxPoint x="415.0" y="298"/><mxPoint x="415.0" y="314"/></Array></mxGeometry></mxCell><mxCell id="c17" value="5. send change, encrypted with the vault key,&lt;br&gt;to devices that joined the vault" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375.0" y="372" as="sourcePoint"/><mxPoint x="625.0" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="6. change, inside the trusted connection (C1)" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="446" as="sourcePoint"/><mxPoint x="875.0" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="7. change" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875.0" y="490" as="sourcePoint"/><mxPoint x="1125.0" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="8. store it (still encrypted until unlocked)" style="html=1;endArrow=block;endFill=1;align=left;spacingLeft=6;labelB