cePoint"/><mxPoint x="1515.0" y="704" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="12. stores it, still encrypted&lt;br&gt;until the vault is unlocked" style="html=1;endArrow=block;endFill=1;align=left;spacingLeft=6;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515.0" y="762" as="sourcePoint"/><mxPoint x="1515.0" y="778" as="targetPoint"/><Array as="points"><mxPoint x="1555.0" y="762"/><mxPoint x="1555.0" y="778"/></Array></mxGeometry></mxCell><mxCell id="c28" value="13. received: change N" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515.0" y="822" as="sourcePoint"/><mxPoint x="915.0" y="822" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="14. acknowledged" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915.0" y="866" as="sourcePoint"/><mxPoint x="515.0" y="866" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="15. keeps the change; when both are online&lt;br&gt;(phone app open), the laptop asks for&lt;br&gt;changes after N" style="html=1;endArrow=block;endFill=1;align=left;spacingLeft=6;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515.0" y="984" as="sourcePoint"/><mxPoint x="515.0" y="1000" as="targetPoint"/><Array as="points"><mxPoint x="555.0" y="984"/><mxPoint x="555.0" y="1000"/></Array></mxGeometry></mxCell><mxCell id="c31" value="16. later, on the laptop: opens the vault&lt;br&gt;with the master password" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115.0" y="1078" as="sourcePoint"/><mxPoint x="1515.0" y="1078" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="17. Argon2id -&gt; wrapping key -&gt;&lt;br&gt;vault key; applies received changes" style="html=1;endArrow=block;endFill=1;align=left;spacingLeft=6;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515.0" y="1136" as="sourcePoint"/><mxPoint x="1515.0" y="1152" as="targetPoint"/><Array as="points"><mxPoint x="1555.0" y="1136"/><mxPoint x="1555.0" y="1152"/></Array></mxGeometry></mxCell><mxCell id="c33" value="18. copies the password" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115.0" y="1196" as="sourcePoint"/><mxPoint x="1515.0" y="1196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="19. clipboard marked secret (never&lt;br&gt;synchronised), cleared after 30 s" style="html=1;endArrow=block;endFill=1;align=left;spacingLeft=6;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515.0" y="1254" as="sourcePoint"/><mxPoint x="1515.0" y="1270" as="targetPoint"/><Array as="points"><mxPoint x="1555.0" y="1254"/><mxPoint x="1555.0" y="1270"/></Array></mxGeometry></mxCell><mxCell id="c35" value="20. ready to paste" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1515.0" y="1314" as="sourcePoint"/><mxPoint x="115.0" y="1314" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>